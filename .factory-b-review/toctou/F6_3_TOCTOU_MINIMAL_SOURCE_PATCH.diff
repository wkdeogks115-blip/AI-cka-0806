+def _secure_directory_flags() -> tuple[int | None, str | None]:
+    required = ("O_RDONLY", "O_DIRECTORY", "O_NOFOLLOW")
+    if any(not hasattr(os, name) for name in required):
+        return None, "secure-openat-flags-unavailable"
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    if hasattr(os, "O_CLOEXEC"):
+        flags |= os.O_CLOEXEC
+    return flags, None
+
+
+def _secure_file_flags() -> tuple[int | None, str | None]:
+    if not hasattr(os, "O_RDONLY") or not hasattr(os, "O_NOFOLLOW"):
+        return None, "secure-openat-flags-unavailable"
+    flags = os.O_RDONLY | os.O_NOFOLLOW
+    if hasattr(os, "O_CLOEXEC"):
+        flags |= os.O_CLOEXEC
+    return flags, None
+
+
+def _read_regular_member_at(root_fd: int, rel: str) -> tuple[str, bytes | None, str | None]:
+    """Read one relative member through descriptor-anchored, no-follow traversal."""
+    dir_flags, err = _secure_directory_flags()
+    file_flags, ferr = _secure_file_flags()
+    if err or ferr or dir_flags is None or file_flags is None:
+        return "ERROR", None, err or ferr
+    parts = PurePosixPath(rel).parts
+    if not parts:
+        return "ERROR", None, "empty-relative-path"
+    current_fd = os.dup(root_fd)
+    try:
+        for part in parts[:-1]:
+            try:
+                next_fd = os.open(part, dir_flags, dir_fd=current_fd)
+            except FileNotFoundError:
+                return "MISSING", None, f"{rel}:missing-component:{part}"
+            except OSError as e:
+                try:
+                    st = os.stat(part, dir_fd=current_fd, follow_symlinks=False)
+                    if stat.S_ISLNK(st.st_mode):
+                        component = "/".join(parts[: parts.index(part) + 1])
+                        return "UNSAFE", None, f"{rel}:symlink-component:{component}"
+                except OSError:
+                    pass
+                return "UNSAFE", None, f"{rel}:unsafe-component:{part}:{type(e).__name__}"
+            os.close(current_fd)
+            current_fd = next_fd
+        leaf = parts[-1]
+        try:
+            fd = os.open(leaf, file_flags, dir_fd=current_fd)
+        except FileNotFoundError:
+            return "MISSING", None, f"{rel}:missing"
+        except OSError as e:
+            return "UNSAFE", None, f"{rel}:unsafe-leaf:{type(e).__name__}"
+        try:
+            st = os.fstat(fd)
+            if not stat.S_ISREG(st.st_mode):
+                return "UNSAFE", None, f"{rel}:not-regular-file"
+            chunks: list[bytes] = []
+            while True:
+                chunk = os.read(fd, 1024 * 1024)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+            return "OK", b"".join(chunks), None
+        except OSError as e:
+            return "ERROR", None, f"{rel}:secure-read-error:{type(e).__name__}"
+        finally:
+            os.close(fd)
+    finally:
+        os.close(current_fd)
+
+
+def _scan_directory_tree_at(root_fd: int) -> tuple[set[str], list[str], list[str]]:
+    """Inventory the opened package root without following symlinks."""
+    dir_flags, err = _secure_directory_flags()
+    if err or dir_flags is None:
+        return set(), [], [err or "secure-openat-flags-unavailable"]
+    actual: set[str] = set()
+    unsafe: list[str] = []
+    errors: list[str] = []
+
+    def walk(dir_fd: int, prefix: str) -> None:
+        try:
+            names = sorted(os.listdir(dir_fd))
+        except OSError as e:
+            errors.append(f"tree-list-error:{prefix or '.'}:{type(e).__name__}")
+            return
+        for name in names:
+            rel = f"{prefix}/{name}" if prefix else name
+            try:
+                st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
+            except FileNotFoundError:
+                errors.append(f"tree-entry-disappeared:{rel}")
+                continue
+            except OSError as e:
+                errors.append(f"tree-stat-error:{rel}:{type(e).__name__}")
+                continue
+            if stat.S_ISLNK(st.st_mode):
+                unsafe.append(f"{rel}:symlink")
+            elif stat.S_ISDIR(st.st_mode):
+                try:
+                    child_fd = os.open(name, dir_flags, dir_fd=dir_fd)
+                except OSError as e:
+                    unsafe.append(f"{rel}:unsafe-directory:{type(e).__name__}")
+                    continue
+                try:
+                    walk(child_fd, rel)
+                finally:
+                    os.close(child_fd)
+            elif stat.S_ISREG(st.st_mode):
+                if rel not in CONTROL_FILES:
+                    actual.add(rel)
+            else:
+                unsafe.append(f"{rel}:not-regular-file")
+
+    walk(root_fd, "")
+    return actual, unsafe, errors
+
